# ========================================================
# STBTOEFL - Environment Variables Example
# Salin file ini menjadi '.env' di root folder sebelum menjalankan aplikasi
# ========================================================

# --- BACKEND SERVER & API ---
PORT=5001
NODE_ENV=development

# --- DATABASE CONFIGURATION (MySQL / XAMPP / MariaDB) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_stbtoefl
DB_PORT=3306

# --- AUTHENTICATION & SECURITY SECRETS ---
JWT_SECRET=your_jwt_secret_key_change_me_in_production
SEB_HASH_SECRET=seb_config_key_hash_secret_toefl_cbt
SEB_STRICT=false

# --- FRONTEND CLIENT (VITE) ---
# Kosongkan jika menggunakan proxy Vite bawaan (/api),
# atau isi URL lengkap backend jika frontend di-host terpisah (misal: http://localhost:5001)
VITE_API_URL=
